<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B13">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="#0B1220">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Irinyi Órarend"
                android:textColor="#F4F7FB"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Betöltés…"
                android:textColor="#9AA8BD"
                android:textSize="12sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="↻"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#17243A"
            android:contentDescription="Frissítés"/>

        <Button
            android:id="@+id/externalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="↗"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#17243A"
            android:contentDescription="Megnyitás böngészőben"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="#5EA0FF"/>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"/>
</LinearLayout>
